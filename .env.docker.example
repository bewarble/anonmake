BOT_TOKEN=replace_with_your_bot_token
BOT_USERNAME=SecretAskRobot

POSTGRES_DB=anonmake
POSTGRES_USER=anonmake
POSTGRES_PASSWORD=replace_with_a_long_random_password

# Docker Compose overrides DATABASE_URL for containers.
# Local example:
# DATABASE_URL=sqlite+aiosqlite:///data/anonmake.db

REDIS_URL=redis://redis:6379/0
LOG_LEVEL=INFO
JSON_LOGS=true
SQL_ECHO=false

ADMIN_IDS=123456789

ABUSE_GUARD_ENABLED=true
QUESTION_BURST_LIMIT=4
QUESTION_BURST_WINDOW_SECONDS=8
QUESTION_MINUTE_LIMIT=20
QUESTION_DUPLICATE_WINDOW_SECONDS=180

BILLING_ENABLED=false
BILLING_WORKER_INTERVAL_SECONDS=60
TRIAL_PRICE_KOPECKS=100
TRIAL_DURATION_HOURS=24
PRIMARY_PRICE_KOPECKS=29900
PRIMARY_DURATION_DAYS=3
FALLBACK_PRICE_KOPECKS=9900
FALLBACK_DURATION_DAYS=1
TRIAL_ATTEMPT_KINDS=trial

IMPAYA_API_URL=https://ag-stage.impaya.ru
IMPAYA_API_TOKEN=
IMPAYA_AUTH_HEADER=Authorization
IMPAYA_AUTH_PREFIX="Bearer "
IMPAYA_PROTOCOL_VERSION=v2.0
IMPAYA_TERMINAL_NAME=evocloud.su_3ds_test
IMPAYA_PAYMENT_FORM_URL_TEMPLATE=
IMPAYA_WEBHOOK_SECRET=
PUBLIC_BASE_URL=https://payments.example.com
OFFER_URL=https://sms.evocloud.su/terms

WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8000

WEB_ADMIN_ENABLED=false
WEB_ADMIN_USERNAME=admin
WEB_ADMIN_PASSWORD=replace_with_a_long_random_password
WEB_ADMIN_SECRET=replace_with_at_least_32_random_characters
WEB_ADMIN_SESSION_MINUTES=480
WEB_ADMIN_SECURE_COOKIE=true

DELIVERY_BATCH_SIZE=100
DELIVERY_POLL_INTERVAL_SECONDS=1
DELIVERY_MAX_ATTEMPTS=10
DELIVERY_LOCK_STALE_SECONDS=120

BROADCAST_BATCH_SIZE=500
BROADCAST_POLL_INTERVAL_SECONDS=3

BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400

BROADCAST_SENDER_TELEGRAM_ID=123456789
