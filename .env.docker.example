#############################
# Telegram
#############################
BOT_TOKEN=

#############################
# PostgreSQL for Docker
#############################
POSTGRES_DB=anonmake
POSTGRES_USER=anonmake
POSTGRES_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD

#############################
# App
#############################
LOG_LEVEL=INFO
SQL_ECHO=false
AUTO_CREATE_TABLES=false

#############################
# Billing
#############################
# Keep false for the first functional bot test.
BILLING_ENABLED=false

TRIAL_PRICE_KOPECKS=100
TRIAL_DURATION_HOURS=24
PRIMARY_PRICE_KOPECKS=29900
PRIMARY_DURATION_DAYS=3
FALLBACK_PRICE_KOPECKS=9900
FALLBACK_DURATION_DAYS=1
BILLING_WORKER_INTERVAL_SECONDS=60

#############################
# Impaya stage
#############################
IMPAYA_API_URL=https://ag-stage.impaya.ru
IMPAYA_API_TOKEN=
IMPAYA_AUTH_HEADER=Authorization
IMPAYA_AUTH_PREFIX=
IMPAYA_TERMINAL_NAME=evocloud.su_3ds_test
IMPAYA_PAYMENT_FORM_URL_TEMPLATE=

#############################
# Public URLs
#############################
# Fill this when HTTPS and an external domain are ready.
PUBLIC_BASE_URL=
IMPAYA_WEBHOOK_SECRET=
OFFER_URL=https://game.mediaempire.su/offer

#############################
# Local web binding
#############################
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8000
