BOT_TOKEN=replace_with_your_bot_token

# Local run defaults to SQLite when DATABASE_URL is omitted.
# DATABASE_URL=sqlite+aiosqlite:///data/anonmake.db

# Docker Compose PostgreSQL settings.
POSTGRES_DB=anonmake
POSTGRES_USER=anonmake
POSTGRES_PASSWORD=replace_with_a_long_random_password

LOG_LEVEL=INFO
SQL_ECHO=false
