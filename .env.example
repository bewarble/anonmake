# Telegram
BOT_TOKEN=
BOT_CODE=primary
BOT_DISPLAY_NAME=AnonMake
MULTIBOT_TOKENS_JSON=
BOT_USERNAME=

# Additional Telegram bots
BOT_TWO_CODE=secondary
BOT_TWO_TOKEN=
BOT_TWO_USERNAME=
BOT_TWO_DISPLAY_NAME=Second Bot

BOT_THREE_CODE=third
BOT_THREE_TOKEN=
BOT_THREE_USERNAME=
BOT_THREE_DISPLAY_NAME=Third Bot

BOT_FOUR_CODE=fourth
BOT_FOUR_TOKEN=
BOT_FOUR_USERNAME=
BOT_FOUR_DISPLAY_NAME=Fourth Bot
ADMIN_IDS=
BROADCAST_SENDER_TELEGRAM_ID=0

# PostgreSQL / Redis
POSTGRES_DB=anonmake
POSTGRES_USER=anonmake
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://anonmake:change-me@db:5432/anonmake
REDIS_URL=redis://redis:6379/0

# Web administration
WEB_ADMIN_ENABLED=true
WEB_ADMIN_USERNAME=admin
WEB_ADMIN_PASSWORD=change-me
WEB_ADMIN_SECRET=change-me-long-random-secret
WEB_ADMIN_SESSION_MINUTES=480
WEB_ADMIN_SECURE_COOKIE=true
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8000
PUBLIC_BASE_URL=https://example.com

# Logging
LOG_LEVEL=INFO
JSON_LOGS=true
SQL_ECHO=false

# Abuse protection
ABUSE_GUARD_ENABLED=true
QUESTION_BURST_LIMIT=4
QUESTION_BURST_WINDOW_SECONDS=8
QUESTION_MINUTE_LIMIT=20
QUESTION_DUPLICATE_WINDOW_SECONDS=180

# Billing
BILLING_ENABLED=false
BILLING_AUTOMATIC_CHARGES_ENABLED=false
BILLING_WORKER_INTERVAL_SECONDS=60
BILLING_WORKER_BATCH_SIZE=100
PAYMENT_TEST_COMMANDS_ENABLED=false
TRIAL_PRICE_KOPECKS=100
TRIAL_DURATION_HOURS=24
PRIMARY_PRICE_KOPECKS=29900
PRIMARY_DURATION_DAYS=3
FALLBACK_PRICE_KOPECKS=9900
FALLBACK_DURATION_DAYS=1
TRIAL_ATTEMPT_KINDS=trial

# Impaya
IMPAYA_API_URL=https://ag-stage.impaya.ru
IMPAYA_API_TOKEN=
IMPAYA_AUTH_HEADER=Authorization
IMPAYA_AUTH_PREFIX="Bearer "
IMPAYA_PROTOCOL_VERSION=v2.0
IMPAYA_TERMINAL_NAME=evocloud.su_3ds_test
IMPAYA_BINDING_TERMINAL_NAME=evocloud.su_3ds_test
IMPAYA_RECURRENT_TERMINAL_NAME=evocloud.su_non3ds_test
IMPAYA_PAYMENT_FORM_URL_TEMPLATE=
IMPAYA_WEBHOOK_SECRET=
OFFER_URL=

# Workers
DELIVERY_BATCH_SIZE=100
DELIVERY_POLL_INTERVAL_SECONDS=1
DELIVERY_MAX_ATTEMPTS=10
DELIVERY_LOCK_STALE_SECONDS=120
BROADCAST_BATCH_SIZE=500
BROADCAST_POLL_INTERVAL_SECONDS=3
