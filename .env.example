BOT_TOKEN=replace_with_your_bot_token

# Local run defaults to SQLite when DATABASE_URL is omitted.
# DATABASE_URL=sqlite+aiosqlite:///data/anonmake.db

# Docker Compose PostgreSQL settings.
POSTGRES_DB=anonmake
POSTGRES_USER=anonmake
POSTGRES_PASSWORD=replace_with_a_long_random_password

LOG_LEVEL=INFO
SQL_ECHO=false

# Impaya VIP billing
BILLING_ENABLED=false
IMPAYA_API_URL=https://ag-stage.impaya.ru
IMPAYA_API_TOKEN=
IMPAYA_AUTH_HEADER=Authorization
IMPAYA_AUTH_PREFIX=
IMPAYA_TERMINAL_NAME=evocloud.su_3ds_test
# Confirm the exact stage payment-form URL in Impaya API Explorer.
# The value must contain {invoice_id}.
IMPAYA_PAYMENT_FORM_URL_TEMPLATE=
OFFER_URL=https://example.com/offer

# Automatic payment callbacks
PUBLIC_BASE_URL=https://payments.example.com
IMPAYA_WEBHOOK_SECRET=
WEB_PORT=8000
BILLING_WORKER_INTERVAL_SECONDS=60

# Redis and observability
REDIS_URL=redis://redis:6379/0
JSON_LOGS=true
ABUSE_GUARD_ENABLED=true

# Telegram administrator IDs, comma-separated
ADMIN_IDS=123456789
\n# PostgreSQL backups\nBACKUP_RETENTION_DAYS=14\nBACKUP_INTERVAL_SECONDS=86400\n
# Impaya API protocol headers
IMPAYA_AUTH_PREFIX=Bearer 
IMPAYA_PROTOCOL_VERSION=v2.0
